**/.venv/*
.env
logs.txt
.db_init_done
db.sqlite
*.parquet
*.csv
.ipynb_checkpoints/
__pycache__/
*.pyc

# NVFlare signature files (generated during job submission)
.__nvfl_sig.json
.__nvfl_submitter.crt

# NVFlare workspace - certificates, keys, and signatures (security-sensitive)
# These are auto-generated during provisioning and should not be in version control
*.crt
*.key
*.pem
workspace/example_project/prod_00/*/startup/signature.json
workspace/example_project/prod_00/*/local/signature.json
workspace/example_project/prod_00/*/.admin_cli_history
workspace/example_project/state/cert.json

# Ansible temporary files
ansible/output.txt

# New client workspace directories (auto-generated)
workspace/example_project/prod_00/k3s-client-06/
workspace/example_project/prod_00/k3s-client-17/
workspace/example_project/prod_00/k3s-client-18/
